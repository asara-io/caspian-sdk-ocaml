# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Official OCaml SDK for the public Caspian API"
description:
  "asara-caspian is the official OCaml SDK for authenticated access to the public Caspian API, including customer-facing health, market data, enriched market data, and policy metadata endpoints."
maintainer: ["Asara"]
authors: ["Asara"]
license: "Apache-2.0"
homepage: "https://github.com/asara-io/caspian-sdk-ocaml"
bug-reports: "https://github.com/asara-io/caspian-sdk-ocaml/issues"
depends: [
  "dune" {>= "3.11"}
  "ocaml" {>= "5.2"}
  "cohttp-lwt-unix"
  "lwt"
  "uri"
  "yojson"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/asara-io/caspian-sdk-ocaml.git"
